# ══════════════════════════════════════════════════════════════════════════════
#  MonCleanerPro — variables d'environnement
#
#  Copiez ce fichier en `.env.local` (jamais commité) et remplissez les valeurs.
#  Sur Vercel, les mêmes clés se saisissent dans Settings → Environment Variables.
#
#  Règle : tout ce qui est préfixé NEXT_PUBLIC_ part dans le navigateur et est
#  donc PUBLIC. Tout le reste doit rester côté serveur — en particulier la clé
#  service_role, qui contourne la RLS.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase — REQUIS ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : routes serveur uniquement (RH, WhatsApp, admin). JAMAIS publique.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions — REQUIS ─────────────────────────────────────────────────────────
# Secret de signature des cookies de session (jose). Une chaîne longue et aléatoire.
SESSION_SECRET=

# ── Notifications push (Web Push / VAPID) ─────────────────────────────────────
# Générer une paire avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@moncleanerpro.fr

# ── Envoi d'e-mails (factures, devis) — SMTP Hostinger ────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Boite reellement authentifiee : contact@moncleanerpro.fr. Les adresses
# ci-dessous en sont des ALIAS — creer l alias chez l hebergeur AVANT de
# l utiliser ici, sinon le serveur refuse l expedition.
SMTP_FROM=info@moncleanerpro.fr
# Expediteurs par nature de message (facultatifs : valeurs par defaut dans
# src/lib/mailFrom.ts). Devis et factures d un cote, rendez-vous de l autre,
# pour que les reponses arrivent dans la bonne boite.
SMTP_FROM_DEVIS=devis@moncleanerpro.fr
SMTP_FROM_RDV=info@moncleanerpro.fr
MAIL_API_KEY=

# ── Tâches planifiées ─────────────────────────────────────────────────────────
# Protège les routes /api/cron/* contre les appels extérieurs.
CRON_SECRET=

# ── Parking ───────────────────────────────────────────────────────────────────
PARKING_PROVIDER=
PARKING_RATE_PER_HOUR=

# ── Suivi d'erreurs (facultatif) ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Alertes WhatsApp (facultatif — inerte si absent) ──────────────────────────
# Prévient la conciergerie quand un dégât est signalé dans un de ses logements.
# Sans ces variables, la fonctionnalité est simplement invisible : rien ne casse.
#
# Prérequis côté Meta, dans cet ordre :
#   1. Meta Business Manager + vérification d'entreprise (2 à 7 jours, documents société)
#   2. Un numéro de téléphone DÉDIÉ, pas déjà utilisé sur WhatsApp ni WhatsApp Business
#   3. Créer une app WhatsApp Business Platform → relever le « Phone number ID »
#   4. Générer un jeton permanent (utilisateur système), pas le jeton temporaire de 24 h
#   5. Faire approuver un modèle catégorie « Utility », langue française, nommé
#      `degat_signale`, avec ce corps et trois variables :
#         Dégât signalé — {{1}}
#         {{2}}
#         Signalé par {{3}}. Détails dans votre espace MonCleanerPro.
#
# Facturation : au message délivré, catégorie utilitaire (quelques centimes en Europe).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Facultatif : seulement si le modèle porte un autre nom que `degat_signale`.
WHATSAPP_TEMPLATE_REPAIR=
