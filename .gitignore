# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Exception : le modèle documente les variables attendues, sans aucune valeur.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# applications mobiles — secrets de signature et projets générés
# La clé de signature Android est IRREMPLAÇABLE : la perdre interdit toute mise
# à jour de l'application, la publier permettrait à un tiers de la remplacer.
mobile/android/*.keystore
mobile/android/*.jks
mobile/android/*.p8
mobile/**/android/
mobile/ios/ios/
mobile/ios/node_modules/
mobile/**/*.aab
mobile/**/*.apk
